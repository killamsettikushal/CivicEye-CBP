%% ==========================================================================
%% CivicEye - UML Activity Diagram (swimlanes)
%% Scenario: citizen submits a new civic issue.
%% Source: IssueReportPanel.attemptSubmit / IssueService.submitIssue
%% ==========================================================================
flowchart TD
    START([Start]):::term

    subgraph LANE_C["Citizen"]
        C1["Fill in category, location and description"]:::task
        C2["Press 'Submit Issue'"]:::task
        C3["Read confirmation message"]:::task
    end

    subgraph LANE_U["Presentation - IssueReportPanel"]
        U1["Disable form, label shows 'Submitting...'"]:::task
        U2{"Any field empty?"}:::decision
        U3["Show 'Please fill in all fields.'"]:::task
        U4["Enable form, show green success message"]:::task
        U5["Show 'Submission failed' error"]:::task
        U6["Clear the form"]:::task
        U7["Call onSuccess.accept(issue)"]:::task
    end

    subgraph LANE_S["Service - IssueService"]
        S1["Validate reporterId is positive"]:::task
        S2{"validateIssueForm(category, location, description)"}:::decision
        S3["Return null (validation message)"]:::task
        S4["Build Issue with status = Pending and createdAt = now"]:::task
    end

    subgraph LANE_D["Data Access - IssueDAO"]
        D1["INSERT INTO issues (reporter_id, category, location, description, status)"]:::task
        D2{"Insert succeeded?"}:::decision
        D3["Write generated issue_id back into the Issue object"]:::task
    end

    START --> C1 --> C2 --> U1 --> U2
    U2 -- "yes" --> U3 --> U1
    U2 -- "no" --> S1 --> S2
    S2 -- "invalid" --> S3 --> U5 --> U1
    S2 -- "valid" --> S4 --> D1 --> D2
    D2 -- "no" --> U5
    D2 -- "yes" --> D3 --> U4 --> U6 --> U7 --> U3
    U7 --> C3

    classDef term fill:#1b2a52,stroke:#5a8bff,color:#dce4ff
    classDef task fill:#101c3d,stroke:#2f4a8f,color:#dce4ff
    classDef decision fill:#2a2140,stroke:#a06bff,color:#e8dcff
