# Full JDBC URL for your local MySQL 8.x server
db.url=jdbc:mysql://localhost:3306/civiceye_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# MySQL username (typically 'root' for local development)
db.user=root

# MySQL password for the above user
db.password=YOUR_MYSQL_PASSWORD_HERE
